# ============================================================
# TezYol Backend — Environment Variables
# Bu faylni .env deb ko'chiring va to'ldiring
# .env faylini HECH QACHON git'ga commit qilmang!
# ============================================================

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/tezyol_db
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# JWT — kamida 64 belgili tasodifiy satr
# Generatsiya: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRATION=86400000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS (Eskiz.uz)
SMS_ENABLED=false
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your_eskiz_password
SMS_SENDER=4546

# Admin
ADMIN_PHONE=+998XXXXXXXXX

# CORS — frontend domenlar (vergul bilan)
CORS_ORIGINS=http://localhost:3001,https://admin.tezyol.uz

# OTP Rate Limiting
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW=15

# Kafka
KAFKA_ENABLED=false
KAFKA_SERVERS=localhost:9092

# Matching
MATCHING_RADIUS_KM=5.0

# Server
PORT=8080
UPLOAD_DIR=uploads
JPA_DDL=update
ERROR_INCLUDE_MESSAGE=never
